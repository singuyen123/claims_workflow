# Copy to .env and adjust. .env is git-ignored.

# Superuser connection. Used only by `npm run db:setup` to create roles and databases.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# Passwords for the two roles created by db:setup.
CLAIMS_OWNER_PASSWORD=owner_dev_password
CLAIMS_APP_PASSWORD=app_dev_password

# Runtime connection (least-privilege role: no UPDATE/DELETE on audit tables).
DATABASE_URL=postgres://claims_app:app_dev_password@localhost:5432/claims_dev
# Migration / seed connection (schema owner).
DATABASE_OWNER_URL=postgres://claims_owner:owner_dev_password@localhost:5432/claims_dev
# Schema that holds all tables in claims_dev.
DB_SCHEMA=claims

# Integration tests connect as the owner; every test file creates and drops its own schema.
TEST_DATABASE_URL=postgres://claims_owner:owner_dev_password@localhost:5432/claims_test

# Key for the HMAC-SHA256 audit hash chain. Required, at least 16 characters; this example value
# is refused when NODE_ENV=production. Use a long random value outside development.
AUDIT_HMAC_KEY=dev-only-change-me

# Workflow definition used for new claims.
WORKFLOW_CONFIG=config/workflow.yaml
